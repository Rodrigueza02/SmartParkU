# ─── Copiar este archivo como .env.production y rellenar los valores ──────────
# Este archivo NO se sube al repositorio (.gitignore ya lo excluye)

# ── PostgreSQL (credenciales del contenedor local en EC2) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA
POSTGRES_DB=smartparku

# ── Backend FastAPI ───────────────────────────────────────────────────────────
# La DATABASE_URL apunta al contenedor db dentro de la red Docker
DATABASE_URL=postgresql+psycopg://postgres:CAMBIAR_POR_PASSWORD_SEGURA@db:5432/smartparku

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERAR_Y_PEGAR_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── MQTT - HiveMQ Cloud ───────────────────────────────────────────────────────
MQTT_BROKER=7de2fa1d05f84c5c8f2fcacca06d98da.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=Juliana
MQTT_PASSWORD=CONTRASEÑA_REAL_DE_HIVEMQ

# ── Puerto del servidor ───────────────────────────────────────────────────────
PORT=8000
